   "source": [
    "import pandas as pd\n",
    "\n",
    "# 读取 CSV 文件\n",
    "df = pd.read_csv(\"../data/sales.csv\", usecols=['订单号', '产品类别', '产品名称', '销售数量', '单价'])\n",
    "# df\n",
    "df['销售额'] = df['销售数量'] * df['单价']\n",
    "\n",
    "# 写入 CSV 文件, index=False 表示不写入索引列\n",
    "df.to_csv(\"../data/sales_output.csv\", index=False)\n"
   ],
